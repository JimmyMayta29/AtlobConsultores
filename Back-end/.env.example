# ============================================
# CONSULTORÍA ATLOB — Backend Environment (Example)
# ============================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5500

DB_HOST=localhost
DB_PORT=3306
DB_NAME=atlob_cms
DB_USER=root
DB_PASS=your_mysql_password

JWT_SECRET=change_this_to_a_random_secure_string
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Consultoría ATLOB <noreply@atlob.com>

ADMIN_EMAIL=admin@atlob.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_NAME=Administrador ATLOB
